{
  "name": "md-tool",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.3.3",
  "publisher": "JefersonPontes",
  "author": "Jeferson Pontes",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#3b5bdb",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fcojefersonpontes/md-tool.git"
  },
  "bugs": {
    "url": "https://github.com/fcojefersonpontes/md-tool/issues"
  },
  "homepage": "https://github.com/fcojefersonpontes/md-tool#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Formatters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "pdf",
    "rtf",
    "export",
    "katex",
    "mermaid",
    "table formatter",
    "toc"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onLanguage:markdown",
    "onWebviewPanel:mdTool.preview"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces%",
      "restrictedConfigurations": [
        "mdTool.markdown.allowHtml",
        "mdTool.preview.customCss"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "mdTool.openPreview",
        "title": "%command.openPreview%",
        "category": "md-tool",
        "icon": "$(book)"
      },
      {
        "command": "mdTool.openPreviewToSide",
        "title": "%command.openPreviewToSide%",
        "category": "md-tool",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "mdTool.showSource",
        "title": "%command.showSource%",
        "category": "md-tool",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mdTool.exportPdf",
        "title": "%command.exportPdf%",
        "category": "md-tool",
        "icon": "$(file-pdf)"
      },
      {
        "command": "mdTool.exportRtf",
        "title": "%command.exportRtf%",
        "category": "md-tool",
        "icon": "$(file-text)"
      },
      {
        "command": "mdTool.openViewer",
        "title": "%command.openViewer%",
        "category": "md-tool",
        "icon": "$(eye)"
      },
      {
        "command": "mdTool.toggleBold",
        "title": "%command.toggleBold%",
        "category": "md-tool",
        "icon": "$(bold)"
      },
      {
        "command": "mdTool.toggleItalic",
        "title": "%command.toggleItalic%",
        "category": "md-tool",
        "icon": "$(italic)"
      },
      {
        "command": "mdTool.toggleStrikethrough",
        "title": "%command.toggleStrikethrough%",
        "category": "md-tool"
      },
      {
        "command": "mdTool.toggleCode",
        "title": "%command.toggleCode%",
        "category": "md-tool",
        "icon": "$(code)"
      },
      {
        "command": "mdTool.toggleCodeBlock",
        "title": "%command.toggleCodeBlock%",
        "category": "md-tool"
      },
      {
        "command": "mdTool.insertLink",
        "title": "%command.insertLink%",
        "category": "md-tool",
        "icon": "$(link)"
      },
      {
        "command": "mdTool.formatTables",
        "title": "%command.formatTables%",
        "category": "md-tool",
        "icon": "$(table)"
      },
      {
        "command": "mdTool.insertToc",
        "title": "%command.insertToc%",
        "category": "md-tool",
        "icon": "$(list-tree)"
      },
      {
        "command": "mdTool.onEnterKey",
        "title": "%command.onEnterKey%",
        "category": "md-tool"
      }
    ],
    "customEditors": [
      {
        "viewType": "mdTool.pdfViewer",
        "displayName": "%viewer.pdf%",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "mdTool.rtfViewer",
        "displayName": "%viewer.rtf%",
        "selector": [
          {
            "filenamePattern": "*.rtf"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdTool.openPreview",
          "when": "editorLangId == markdown && !notebookEditorFocused",
          "group": "navigation@-2"
        },
        {
          "command": "mdTool.openPreviewToSide",
          "when": "editorLangId == markdown && !notebookEditorFocused",
          "group": "navigation@-1"
        },
        {
          "command": "mdTool.showSource",
          "when": "activeWebviewPanelId == 'mdTool.preview'",
          "group": "navigation@0"
        },
        {
          "command": "mdTool.exportPdf",
          "when": "activeWebviewPanelId == 'mdTool.preview'",
          "group": "navigation@1"
        },
        {
          "command": "mdTool.exportRtf",
          "when": "activeWebviewPanelId == 'mdTool.preview'",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "mdTool.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "mdTool.exportPdf",
          "when": "resourceLangId == markdown",
          "group": "navigation@10"
        },
        {
          "command": "mdTool.exportRtf",
          "when": "resourceLangId == markdown",
          "group": "navigation@11"
        },
        {
          "command": "mdTool.openViewer",
          "when": "resourceExtname =~ /^.(pdf|rtf)$/i",
          "group": "navigation@12"
        }
      ],
      "commandPalette": [
        {
          "command": "mdTool.openPreview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mdTool.openPreviewToSide",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mdTool.showSource",
          "when": "activeWebviewPanelId == 'mdTool.preview'"
        },
        {
          "command": "mdTool.exportPdf",
          "when": "editorLangId == markdown || activeWebviewPanelId == 'mdTool.preview'"
        },
        {
          "command": "mdTool.exportRtf",
          "when": "editorLangId == markdown || activeWebviewPanelId == 'mdTool.preview'"
        },
        {
          "command": "mdTool.openViewer"
        },
        {
          "command": "mdTool.toggleBold",
          "when": "editorLangId == markdown && !editorReadonly"
        },
        {
          "command": "mdTool.toggleItalic",
          "when": "editorLangId == markdown && !editorReadonly"
        },
        {
          "command": "mdTool.toggleStrikethrough",
          "when": "editorLangId == markdown && !editorReadonly"
        },
        {
          "command": "mdTool.toggleCode",
          "when": "editorLangId == markdown && !editorReadonly"
        },
        {
          "command": "mdTool.toggleCodeBlock",
          "when": "editorLangId == markdown && !editorReadonly"
        },
        {
          "command": "mdTool.insertLink",
          "when": "editorLangId == markdown && !editorReadonly"
        },
        {
          "command": "mdTool.formatTables",
          "when": "editorLangId == markdown && !editorReadonly"
        },
        {
          "command": "mdTool.insertToc",
          "when": "editorLangId == markdown && !editorReadonly"
        },
        {
          "command": "mdTool.onEnterKey",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "submenu": "mdTool.edit",
          "when": "editorLangId == markdown",
          "group": "md-tool@0"
        },
        {
          "command": "mdTool.exportPdf",
          "when": "editorLangId == markdown",
          "group": "md-tool@1"
        },
        {
          "command": "mdTool.exportRtf",
          "when": "editorLangId == markdown",
          "group": "md-tool@2"
        }
      ],
      "mdTool.edit": [
        {
          "command": "mdTool.toggleBold",
          "group": "1_style@1"
        },
        {
          "command": "mdTool.toggleItalic",
          "group": "1_style@2"
        },
        {
          "command": "mdTool.toggleStrikethrough",
          "group": "1_style@3"
        },
        {
          "command": "mdTool.toggleCode",
          "group": "1_style@4"
        },
        {
          "command": "mdTool.toggleCodeBlock",
          "group": "1_style@5"
        },
        {
          "command": "mdTool.insertLink",
          "group": "2_insert@1"
        },
        {
          "command": "mdTool.insertToc",
          "group": "2_insert@2"
        },
        {
          "command": "mdTool.formatTables",
          "group": "3_format@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mdTool.openPreviewToSide",
        "key": "ctrl+k alt+v",
        "mac": "cmd+k alt+v",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mdTool.toggleBold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && editorLangId == markdown && !editorReadonly"
      },
      {
        "command": "mdTool.toggleItalic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorLangId == markdown && !editorReadonly"
      },
      {
        "command": "mdTool.insertLink",
        "key": "ctrl+k l",
        "mac": "cmd+k l",
        "when": "editorTextFocus && editorLangId == markdown && !editorReadonly"
      },
      {
        "command": "mdTool.onEnterKey",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == markdown && !editorReadonly && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && config.mdTool.editor.listContinuation"
      }
    ],
    "configuration": {
      "title": "md-tool",
      "properties": {
        "mdTool.preview.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.preview.theme.auto%",
            "%config.preview.theme.light%",
            "%config.preview.theme.dark%"
          ],
          "description": "%config.preview.theme%"
        },
        "mdTool.preview.customCss": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "%config.preview.customCss%"
        },
        "mdTool.preview.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "%config.preview.scrollSync%"
        },
        "mdTool.markdown.allowHtml": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "%config.markdown.allowHtml%"
        },
        "mdTool.markdown.math": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%config.markdown.math%"
        },
        "mdTool.markdown.mermaid": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%config.markdown.mermaid%"
        },
        "mdTool.export.profile": {
          "type": "string",
          "enum": [
            "default",
            "abnt"
          ],
          "enumDescriptions": [
            "%config.export.profile.default%",
            "%config.export.profile.abnt%"
          ],
          "default": "default",
          "scope": "resource",
          "markdownDescription": "%config.export.profile%"
        },
        "mdTool.export.outputDir": {
          "type": "string",
          "default": "${fileDirname}",
          "scope": "resource",
          "markdownDescription": "%config.export.outputDir%"
        },
        "mdTool.export.askLocation": {
          "type": "boolean",
          "default": false,
          "description": "%config.export.askLocation%"
        },
        "mdTool.export.pageSize": {
          "type": "string",
          "enum": [
            "A4",
            "Letter",
            "Legal"
          ],
          "default": "A4",
          "scope": "resource",
          "description": "%config.export.pageSize%"
        },
        "mdTool.export.landscape": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "%config.export.landscape%"
        },
        "mdTool.export.margin": {
          "type": "string",
          "default": "20mm",
          "scope": "resource",
          "markdownDescription": "%config.export.margin%"
        },
        "mdTool.export.fontFamily": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.export.fontFamily%"
        },
        "mdTool.export.codeFontFamily": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.export.codeFontFamily%"
        },
        "mdTool.export.fontSize": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 6,
          "maximum": 72,
          "scope": "resource",
          "description": "%config.export.fontSize%"
        },
        "mdTool.pdf.header": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.pdf.header%"
        },
        "mdTool.pdf.footer": {
          "type": "string",
          "default": "{page} / {pages}",
          "scope": "resource",
          "markdownDescription": "%config.pdf.footer%"
        },
        "mdTool.editor.listContinuation": {
          "type": "boolean",
          "default": true,
          "description": "%config.editor.listContinuation%"
        },
        "mdTool.editor.formatTables": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.editor.formatTables%"
        },
        "mdTool.toc.minLevel": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 6,
          "scope": "resource",
          "description": "%config.toc.minLevel%"
        },
        "mdTool.toc.maxLevel": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 6,
          "scope": "resource",
          "description": "%config.toc.maxLevel%"
        },
        "mdTool.toc.updateOnSave": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.toc.updateOnSave%"
        }
      }
    },
    "submenus": [
      {
        "id": "mdTool.edit",
        "label": "%submenu.edit%"
      }
    ]
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run check-types && node esbuild.mjs --production",
    "check-types": "tsc --noEmit && tsc --noEmit -p webview",
    "lint": "eslint src webview test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:integration": "npm run compile && tsc -p test/integration/tsconfig.json",
    "test:integration": "vscode-test",
    "vscode:prepublish": "npm run package",
    "vsix": "vsce package --no-dependencies",
    "test:browser": "vitest run --config vitest.browser.config.mts",
    "pretest:browser": "npm run compile",
    "screenshots": "npm run compile && node scripts/screenshots/run.mjs"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "dompurify": "^3.4.17",
    "fontkit": "^2.0.4",
    "katex": "^0.19.0",
    "markdown-it": "^14.3.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-front-matter": "^0.2.4",
    "mathjax-full": "^3.2.2",
    "mermaid": "^12.2.0",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "^0.20.2",
    "shiki": "^4.5.0",
    "svg-to-pdfkit": "^0.1.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fontkit": "^2.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/pdfkit": "^0.17.7",
    "@types/svg-to-pdfkit": "^0.1.4",
    "@types/vscode": "1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "gifenc": "^1.0.3",
    "jsdom": "^29.1.1",
    "ovsx": "^1.3.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@vscode/markdown-it-katex": {
      "katex": "$katex"
    }
  }
}
