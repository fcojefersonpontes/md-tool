{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "never" },
      "problemMatcher": {
        "owner": "esbuild",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^✘ \[ERROR\] (.*)$|^    (.*):(\d+):(\d+):$",
          "message": 1,
          "file": 2,
          "line": 3,
          "column": 4
        },
        "background": {
          "activeBegins": true,
          "beginsPattern": "^\[watch\] build started",
          "endsPattern": "^\[watch\] build finished"
        }
      }
    }
  ]
}
